[Unit]
Description=Apply power-profile defaults when the power source changes
ConditionPathExistsGlob=/sys/class/power_supply/BAT*/type

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/awesome/utilities/power/power-profile-monitor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
