[Unit]
Description=Apply power-profile defaults when the power source changes
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/awesome/utilities/power-profile-monitor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
