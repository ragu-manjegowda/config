[Unit]
Description=Laptop Display Brightness Manager (Event-based)
After=graphical-session.target
ConditionPathExistsGlob=/proc/acpi/button/lid/*/state

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=%h/.config/scripts/lid-brightness-monitor
ExecReload=/usr/bin/kill -HUP $MAINPID
ExecStop=%h/.config/scripts/lid-brightness-monitor --restore
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
