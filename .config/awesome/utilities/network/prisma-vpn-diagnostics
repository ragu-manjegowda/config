#!/usr/bin/env bash

set -u
umask 077

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/prisma-access-agent"
output="$state_dir/vpn-health-$(date +%Y%m%dT%H%M%S%z).log"
agent_run="${PRISMA_VPN_AGENT_RUN:-/usr/lib/prisma-access-agent/run}"

mkdir -p "$state_dir"
{
    date --iso-8601=seconds
    printf '\n[prisma status]\n'
    timeout 5 "$agent_run" PACli status --relative 2>&1 || true
    printf '\n[ip rules]\n'
    ip rule show
    printf '\n[ip routes]\n'
    ip route show table all
    ip -6 route show table all
    printf '\n[resolver]\n'
    resolvectl status
    printf '\n[networkmanager]\n'
    nmcli general status
} >"$output"

printf '%s\n' "$output"
