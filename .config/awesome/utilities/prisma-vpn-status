#!/usr/bin/env bash

set -u

systemctl_bin="${PRISMA_VPN_SYSTEMCTL_BIN:-/usr/bin/systemctl}"
agent_run="${PRISMA_VPN_AGENT_RUN:-/usr/lib/prisma-access-agent/run}"
timeout_bin="${PRISMA_VPN_TIMEOUT_BIN:-/usr/bin/timeout}"
timeout_seconds="${PRISMA_VPN_TIMEOUT_SECONDS:-2}"
namespace_service='prisma-access-agent.service'
host_service='prisma-access-agent-host.service'

if "$systemctl_bin" is-active --quiet "$host_service"; then
    mode='global'
elif "$systemctl_bin" is-active --quiet "$namespace_service"; then
    mode='namespace'
else
    printf 'disconnected\n'
    exit 0
fi

if ! status=$("$timeout_bin" "$timeout_seconds" \
    "$agent_run" PACli status --relative 2>/dev/null); then
    printf 'unavailable %s\n' "$mode"
    exit 0
fi

tunnel_status=''
while IFS=: read -r key value; do
    if [[ "$key" == Tunnel ]]; then
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        tunnel_status="$value"
        break
    fi
done <<<"$status"

case "$tunnel_status" in
    Connected) printf 'connected %s\n' "$mode" ;;
    Connecting) printf 'connecting %s\n' "$mode" ;;
    *) printf 'disconnected %s\n' "$mode" ;;
esac
