#!/usr/bin/env bash

set -euo pipefail

profilectl="${POWER_PROFILE_CTL:-powerprofilesctl}"
light_bin="${POWER_PROFILE_LIGHT_BIN:-light}"
rfkill_bin="${POWER_PROFILE_RFKILL_BIN:-rfkill}"
bluetoothctl_bin="${POWER_PROFILE_BLUETOOTHCTL_BIN:-bluetoothctl}"
upower_bin="${POWER_PROFILE_UPOWER_BIN:-upower}"
timeout_seconds="${POWER_PROFILE_TIMEOUT_SECONDS:-5}"
systemctl_bin="${POWER_PROFILE_SYSTEMCTL_BIN:-systemctl}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/awesome"
state_file="$state_dir/power-profile"
bluetooth_state_file="$state_dir/power-profile-bluetooth"
epp_dir="${POWER_PROFILE_EPP_DIR:-/sys/devices/system/cpu/cpufreq}"
no_turbo="${POWER_PROFILE_NO_TURBO:-/sys/devices/system/cpu/intel_pstate/no_turbo}"

current_profile() {
    timeout "$timeout_seconds" "$profilectl" get | tr -d '[:space:]'
}

visible_profile() {
    local current policy all_power=true
    current="$(current_profile)"
    if [[ "$current" == balanced && -r "$state_file" && "$(<"$state_file")" == power-saver ]]; then
        shopt -s nullglob
        local -a policies=("$epp_dir"/policy*/energy_performance_preference)
        shopt -u nullglob
        if [[ ${#policies[@]} -gt 0 && -r "$no_turbo" && "$(<"$no_turbo")" == 1 ]]; then
            for policy in "${policies[@]}"; do
                if [[ ! -r "$policy" || "$(<"$policy")" != power ]]; then
                    all_power=false
                    break
                fi
            done
            if [[ "$all_power" == true ]]; then
                printf 'power-saver\n'
                return
            fi
        fi
    fi
    printf '%s\n' "$current"
}

on_ac_power() {
    if [[ -n "${POWER_PROFILE_ON_BATTERY:-}" ]]; then
        [[ "$POWER_PROFILE_ON_BATTERY" != true ]]
        return
    fi

    while IFS= read -r device; do
        if timeout "$timeout_seconds" "$upower_bin" -i "$device" 2>/dev/null |
            grep -Eq '^[[:space:]]*online:[[:space:]]+yes$'; then
            return 0
        fi
    done < <(timeout "$timeout_seconds" "$upower_bin" -e | grep '/line_power_')

    return 1
}

set_bluetooth() {
    local enabled="$1"
    local current

    if [[ "$enabled" == true ]]; then
        "$rfkill_bin" unblock bluetooth >/dev/null 2>&1 ||
            printf 'Could not unblock Bluetooth\n' >&2
        if ! timeout "$timeout_seconds" "$bluetoothctl_bin" power on >/dev/null 2>&1; then
            current="$(bluetooth_power_state 2>/dev/null)" || current=''
            [[ "$current" == yes ]] || printf 'Could not power on Bluetooth\n' >&2
        fi
    else
        if ! timeout "$timeout_seconds" "$bluetoothctl_bin" power off >/dev/null 2>&1; then
            current="$(bluetooth_power_state 2>/dev/null)" || current=''
            [[ "$current" == no ]] || printf 'Could not power off Bluetooth\n' >&2
        fi
        "$rfkill_bin" block bluetooth >/dev/null 2>&1 ||
            printf 'Could not block Bluetooth\n' >&2
    fi
}

bluetooth_power_state() {
    local output
    output="$(timeout "$timeout_seconds" "$bluetoothctl_bin" show)" || return 1
    if [[ "$output" =~ Powered:[[:space:]]+(yes|no) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    else
        printf 'Bluetooth power state is unavailable\n' >&2
        return 1
    fi
}

apply_baseline() {
    local profile="$1"
    local brightness

    case "$profile" in
        performance)
            brightness=100
            ;;
        balanced)
            brightness=60
            ;;
        power-saver)
            brightness=35
            ;;
        *)
            return 2
            ;;
    esac

    "$light_bin" -S "$brightness" >/dev/null 2>&1 ||
        printf 'Could not set brightness to %s%%\n' "$brightness" >&2
}

set_profile() {
    local profile="$1"
    local previous_profile previous_daemon previous_bluetooth daemon_profile="$profile"

    case "$profile" in
        performance|balanced|power-saver) ;;
        *)
            printf 'Unsupported power profile: %s\n' "$profile" >&2
            return 2
            ;;
    esac

    mkdir -p "$state_dir"
    exec {lock_fd}> "$state_dir/power-profile.lock"
    flock -w "$timeout_seconds" "$lock_fd" || {
        printf 'Another power-profile change is in progress\n' >&2
        return 1
    }

    previous_profile="$(visible_profile)"
    previous_daemon="$(current_profile)"
    if [[ "$profile" == power-saver && "$previous_profile" != power-saver ]]; then
        previous_bluetooth="$(bluetooth_power_state)" || return 1
    fi
    # This firmware advertises power-saver, but resolves it back to balanced.
    # The root-owned unit applies its EPP/turbo policy and restores EPP when
    # leaving power-saver for balanced.
    if [[ "$profile" == power-saver ]]; then daemon_profile=balanced; fi
    timeout "$timeout_seconds" "$profilectl" set "$daemon_profile"
    if ! timeout "$timeout_seconds" "$systemctl_bin" start "awesome-power-profile-policy@${profile}.service"; then
        timeout "$timeout_seconds" "$profilectl" set "$previous_daemon" ||
            printf 'Could not restore previous daemon profile: %s\n' "$previous_daemon" >&2
        timeout "$timeout_seconds" "$systemctl_bin" start "awesome-power-profile-policy@${previous_profile}.service" ||
            printf 'Could not restore previous CPU policy: %s\n' "$previous_profile" >&2
        return 1
    fi
    apply_baseline "$profile"

    if [[ "$profile" == power-saver ]]; then
        if [[ "$previous_profile" != power-saver ]]; then
            printf '%s\n' "$previous_bluetooth" > "$bluetooth_state_file"
        fi
        set_bluetooth false
    else
        if [[ "$previous_profile" == power-saver && -r "$bluetooth_state_file" &&
            "$(<"$bluetooth_state_file")" == yes ]]; then
            set_bluetooth true
        fi
        rm -f -- "$bluetooth_state_file"
    fi

    printf '%s\n' "$profile" > "$state_file"
    printf '%s\n' "$profile"
}

case "${1:-}" in
    get)
        visible_profile
        ;;
    set)
        [[ $# -eq 2 ]] || exit 2
        set_profile "$2"
        ;;
    cycle)
        case "$(visible_profile)" in
            performance) set_profile balanced ;;
            balanced) set_profile power-saver ;;
            *) set_profile performance ;;
        esac
        ;;
    default)
        if on_ac_power; then
            set_profile performance
        else
            set_profile balanced
        fi
        ;;
    *)
        printf 'Usage: %s {get|set PROFILE|cycle|default}\n' "${0##*/}" >&2
        exit 2
        ;;
esac
