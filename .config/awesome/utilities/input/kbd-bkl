#!/usr/bin/env bash

set -euo pipefail

operation="$1"
percent="$2"
brightness_path="$3"
max_path="$(dirname "$brightness_path")/max_brightness"

current="$(<"$brightness_path")"
maximum="$(<"$max_path")"
step=$(((maximum * percent + 99) / 100))
((step > 0)) || step=1

case "$operation" in
    -inc)
        value=$((current + step))
        ((value <= maximum)) || value="$maximum"
        ;;
    -dec)
        value=$((current - step))
        ((value >= 0)) || value=0
        ;;
    *)
        exit 2
        ;;
esac

printf '%s\n' "$value" > "$brightness_path"
