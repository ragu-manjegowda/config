#!/usr/bin/env bash

set -euo pipefail

# Extended display with an explicit framebuffer covering both logical outputs.
# Configuration is read from config.lua via read-display-config

# Source the configuration from config.lua
display_config="$("$HOME/.config/awesome/utilities/display/read-display-config")"
source /dev/stdin <<<"$display_config"
unset display_config

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
lock_file="${XDG_RUNTIME_DIR}/awesome-display-transition-${UID}.lock"
inherited_lock=false
if [[ "${DISPLAY_TRANSITION_LOCK_FD:-}" == 9 &&
      "$(readlink /proc/$$/fd/9 2>/dev/null || true)" == "$lock_file" ]]; then
    inherited_lock=true
fi
if [[ "$inherited_lock" != true ]]; then
    exec 9>"$lock_file"
fi
if ! flock -n 9; then
    printf '%s\n' 'Another display transition is already running' >&2
    exit 1
fi

xrandr_args=(
    xrandr --dpi "$DISPLAY_DPI"
    --output "$PRIMARY_NAME" --primary --mode "$PRIMARY_MODE" --pos "$PRIMARY_POS"
    --scale 1x1
)

framebuffer_width=0
framebuffer_height=0
include_output_extent() {
    local width height x y
    IFS=x read -r width height <<< "$1"
    IFS=x read -r x y <<< "$2"
    width=$((10#$width)); height=$((10#$height))
    x=$((10#$x)); y=$((10#$y))
    if (( width <= 0 || height <= 0 )); then
        printf '%s\n' 'Display dimensions must be positive' >&2
        return 1
    fi
    (( x + width <= framebuffer_width )) || framebuffer_width=$((x + width))
    (( y + height <= framebuffer_height )) || framebuffer_height=$((y + height))
}
include_output_extent "$PRIMARY_MODE" "$PRIMARY_POS"

# Check if external monitor is connected
external_connected=false
display_state="$(xrandr --current)"
while IFS= read -r line; do
    read -r output connection _ <<<"$line"
    if [[ "$output" == "$EXTERNAL_NAME" && "$connection" == connected ]]; then
        external_connected=true
        break
    fi
done <<<"$display_state"
if [[ "$external_connected" == true ]]; then
    external_args=(
        xrandr
        --output "$EXTERNAL_NAME"
        --mode "$EXTERNAL_MODE"
        --pos "$EXTERNAL_POS"
    )

    # Add scaling if configured
    if [ -n "$EXTERNAL_SCALE_FROM" ]; then
        external_args+=(--scale-from "$EXTERNAL_SCALE_FROM")
    else
        external_args+=(--scale 1x1)
    fi

    include_output_extent "${EXTERNAL_SCALE_FROM:-$EXTERNAL_MODE}" "$EXTERNAL_POS"
    xrandr_args+=("${external_args[@]:1}")
    xrandr_args+=(--fb "${framebuffer_width}x${framebuffer_height}")
    "${xrandr_args[@]}"

    echo "✓ Extended display configured:"
    echo "  - Primary ($PRIMARY_NAME): $PRIMARY_MODE @ $PRIMARY_POS"
    echo "  - External ($EXTERNAL_NAME): $EXTERNAL_MODE @ $EXTERNAL_POS"
    [ -n "$EXTERNAL_SCALE_FROM" ] && echo "  - Scaling: from $EXTERNAL_SCALE_FROM"
    echo "  - DPI: $DISPLAY_DPI"
else
    xrandr_args+=(--fb "${framebuffer_width}x${framebuffer_height}")
    "${xrandr_args[@]}"
    echo "$EXTERNAL_NAME not connected, using $PRIMARY_NAME only"
fi

"$HOME/.config/awesome/utilities/display/reset-primary-display" --once

if systemctl --user cat lid-brightness-manager.service &>/dev/null; then
    systemctl --user reload-or-restart lid-brightness-manager.service ||
        echo "Warning: failed to refresh lid brightness manager" >&2
fi
