#!/usr/bin/env lua

-- Helper script to read display configuration from config.lua
-- This allows bash scripts to source AwesomeWM configuration
-- Usage: source <(utilities/read-display-config)

-- Determine the AwesomeWM config directory
-- In CI: use the script's actual location
-- Locally: use $HOME/.config/awesome
local function get_script_dir()
    local str = debug.getinfo(1, "S").source:sub(2)
    return str:match("(.*/)")
end

local script_dir = get_script_dir()
local awful_config_dir

if script_dir and script_dir:match("utilities/?$") then
    -- Script is in utilities/ directory, go up one level
    awful_config_dir = script_dir:gsub("utilities/?$", "")
else
    -- Fallback to HOME
    awful_config_dir = os.getenv("HOME") .. "/.config/awesome/"
end

-- Remove trailing slash if present, then add it back for consistency
awful_config_dir = awful_config_dir:gsub("/$", "")

-- Set up Lua path to find AwesomeWM modules
package.path = awful_config_dir .. "/?.lua;" ..
               awful_config_dir .. "/?/init.lua;" ..
               package.path

-- Mock gears.filesystem for standalone use
package.loaded['gears.filesystem'] = {
    get_configuration_dir = function()
        return awful_config_dir .. "/"
    end
}

-- Load the configuration
local config = require('configuration.config')
local d = config.display
local screen_recorder = config.widget and config.widget.screen_recorder or {}
local screenshot = config.widget and config.widget.screenshot or {}

local function require_value(name, value, pattern)
    if type(value) ~= 'string' or not value:match(pattern) then
        error('invalid ' .. name)
    end
    return value
end

local primary_name = require_value('primary display name', d.primary.name, '^[%w_.:-]+$')
local primary_mode = require_value('primary display mode', d.primary.mode, '^%d+x%d+$')
local primary_pos = require_value('primary display position', d.primary.position, '^%d+x%d+$')
local external_name = require_value('external display name', d.external.name, '^[%w_.:-]+$')
if primary_name == external_name then
    error('primary and external display names must differ')
end
local external_mode = require_value('external display mode', d.external.mode, '^%d+x%d+$')
local external_pos = require_value('external display position', d.external.position, '^%d+x%d+$')
local external_scale = d.external.scale_from or ''
if external_scale ~= '' then
    external_scale = require_value('external display scale', external_scale, '^%d+x%d+$')
end
local recorder_target = require_value(
    'screen recorder target', screen_recorder.display_target or 'primary', '^[%w_-]+$')
local screenshot_target = require_value(
    'screenshot target', screenshot.display_target or 'both', '^[%w_-]+$')

-- Output bash-compatible variable assignments
print(string.format('export DISPLAY_DPI=%d', d.dpi))
print(string.format('export PRIMARY_NAME="%s"', primary_name))
print(string.format('export PRIMARY_MODE="%s"', primary_mode))
print(string.format('export PRIMARY_POS="%s"', primary_pos))
print(string.format('export EXTERNAL_NAME="%s"', external_name))
print(string.format('export EXTERNAL_MODE="%s"', external_mode))
print(string.format('export EXTERNAL_POS="%s"', external_pos))
print(string.format('export EXTERNAL_SCALE_FROM="%s"', external_scale))
print(string.format('export SCREEN_RECORDER_TARGET="%s"', recorder_target))
print(string.format('export SCREENSHOT_TARGET="%s"', screenshot_target))
