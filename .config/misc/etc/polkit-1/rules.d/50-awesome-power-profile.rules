/* Permit wheel users, including background user services, to switch profiles,
 * disable competing battery automation, and start fixed turbo-policy units. */
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) {
        return;
    }

    if (action.id == "org.freedesktop.UPower.PowerProfiles.switch-profile" ||
        action.id == "org.freedesktop.UPower.PowerProfiles.configure-battery-aware") {
        return polkit.Result.YES;
    }

    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" &&
        ["awesome-power-profile-policy@performance.service",
         "awesome-power-profile-policy@balanced.service",
         "awesome-power-profile-policy@power-saver.service"].indexOf(action.lookup("unit")) !== -1) {
        return polkit.Result.YES;
    }
});
