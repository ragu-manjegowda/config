[Desktop Entry]
Type=Application
TryExec=alacritty
Exec=env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 WINIT_UNIX_BACKEND=x11 alacritty
Icon=Alacritty
Terminal=false
Categories=System;TerminalEmulator;

Name=Alacritty
GenericName=Terminal
Comment=A fast, cross-platform, OpenGL terminal emulator
StartupNotify=true
StartupWMClass=Alacritty
Actions=New;

[Desktop Action New]
Name=New Terminal
Exec=env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 WINIT_UNIX_BACKEND=x11 alacritty
