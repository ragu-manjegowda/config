#!/usr/bin/env bash

set -u

prefix=""
ports="22"
timeout="2"
workers="32"
hostname_timeout="1"
hostname_attempts="2"
excludes=()
port_list=()
excluded_ips=()
accent_color=""
bold=""
log_style=""
reset=""

alacritty_uses_dark_theme() {
    local config="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
    local line

    [[ -r "$config" ]] || return 1

    while IFS= read -r line; do
        line="$(printf '%s\n' "$line" | tr '[:upper:]' '[:lower:]')"
        [[ "$line" == *import* && "$line" == *dark* ]] && return 0
    done < "$config"

    return 1
}

accent_index=4
log_index=14
if alacritty_uses_dark_theme; then
    accent_index=2
    log_index=10
fi

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    accent_color="$(tput setaf "$accent_index" 2>/dev/null || true)"
    bold="$(tput bold 2>/dev/null || true)"
fi

if [[ -t 2 ]] && command -v tput >/dev/null 2>&1; then
    log_style="$(tput setaf "$log_index" 2>/dev/null || true)"
fi

if [[ -n "$accent_color" || -n "$bold" || -n "$log_style" ]]; then
    reset="$(tput sgr0 2>/dev/null || true)"
fi

log() {
    printf '%sfindip: %s%s\n' "$log_style" "$*" "$reset" >&2
}

run_with_timeout() {
    local seconds="$1"
    local command_pid
    local timer_pid
    local status
    shift

    "$@" &
    command_pid=$!
    (
        sleep "$seconds"
        kill -KILL "$command_pid" 2>/dev/null || true
    ) &
    timer_pid=$!

    wait "$command_pid" 2>/dev/null
    status=$?
    kill "$timer_pid" 2>/dev/null || true
    wait "$timer_pid" 2>/dev/null || true
    return "$status"
}

usage() {
    printf 'Usage: findip [--prefix PREFIX] [--ports PORTS] [--timeout SECONDS] [--workers N] [--exclude IP]\n'
    printf 'Default prefix is auto-detected from the active 192.168.x.y address.\n'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --prefix)
            prefix="$2"
            shift 2
            ;;
        --ports)
            ports="$2"
            shift 2
            ;;
        --timeout)
            timeout="$2"
            shift 2
            ;;
        --workers)
            workers="$2"
            shift 2
            ;;
        --exclude)
            excludes+=("$2")
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'findip: unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

local_ips() {
    if command -v ip >/dev/null 2>&1; then
        ip -o -4 addr show scope global 2>/dev/null | while read -r _ _ _ address _; do
            address="${address%%/*}"
            [[ "$address" == 192.168.* ]] && printf '%s\n' "$address"
        done
    elif command -v ifconfig >/dev/null 2>&1; then
        ifconfig 2>/dev/null | awk '$1 == "inet" && $2 ~ /^192\.168\./ { print $2 }'
    fi
}

detect_prefix() {
    local address

    while read -r address; do
        [[ -z "$address" ]] && continue
        printf '%s.\n' "${address%.*}"
        return
    done < <(local_ips)

    return 1
}

IFS=',' read -r -a port_list <<< "$ports"
if [[ -z "$prefix" ]]; then
    log 'detecting active 192.168.x.y network prefix'
    if ! prefix="$(detect_prefix)"; then
        printf 'findip: could not detect a 192.168.x.y address; pass --prefix manually\n' >&2
        exit 2
    fi
else
    log "using prefix from --prefix: $prefix"
fi
log "using scan prefix: $prefix"

is_excluded() {
    local ip="$1"
    local excluded

    for excluded in ${excluded_ips[@]+"${excluded_ips[@]}"}; do
        [[ "$ip" == "$excluded" ]] && return 0
    done

    return 1
}

discover_bonjour_hosts() {
    local browse_output
    local instance
    local target
    local address

    command -v dns-sd >/dev/null 2>&1 || return
    command -v dscacheutil >/dev/null 2>&1 || return

    browse_output="$(run_with_timeout "$hostname_timeout" dns-sd -B _ssh._tcp local 2>/dev/null)"
    while IFS= read -r instance; do
        [[ -z "$instance" ]] && continue
        target="$(
            run_with_timeout "$hostname_timeout" dns-sd -L "$instance" _ssh._tcp local 2>/dev/null \
                | awk '
                    /can be reached at/ {
                        for (i = 1; i <= NF; i += 1) {
                            if ($i == "at") {
                                target = $(i + 1)
                                sub(/:[0-9]+$/, "", target)
                                sub(/\.$/, "", target)
                                print target
                                exit
                            }
                        }
                    }
                '
        )"
        [[ -z "$target" ]] && continue

        run_with_timeout "$hostname_timeout" dscacheutil -q host -a name "$target" 2>/dev/null \
            | awk -v host="${target%.local}" -v network="$prefix" '
                $1 == "ip_address:" && index($2, network) == 1 {
                    print $2 "\t" host
                }
            '
    done < <(
        printf '%s\n' "$browse_output" \
            | awk '
                $2 == "Add" && $6 == "_ssh._tcp." {
                    instance = $7
                    for (i = 8; i <= NF; i += 1) instance = instance " " $i
                    print instance
                }
            ' \
            | LC_ALL=C sort -u
    )
}

hostname_for() {
    local ip="$1"
    local host=""
    local attempt

    host="$(awk -F '\t' -v ip="$ip" '$1 == ip { print $2; exit }' "$hostname_file")"
    if [[ -n "$host" ]]; then
        printf '%s\n' "$host"
        return
    fi

    for ((attempt = 1; attempt <= hostname_attempts; attempt += 1)); do
        if command -v getent >/dev/null 2>&1; then
            if command -v timeout >/dev/null 2>&1; then
                host="$(timeout "$hostname_timeout" getent hosts "$ip" 2>/dev/null | { read -r _ name _; printf '%s' "${name:-}"; })"
            else
                host="$(getent hosts "$ip" 2>/dev/null | { read -r _ name _; printf '%s' "${name:-}"; })"
            fi
        elif command -v dscacheutil >/dev/null 2>&1; then
            host="$(run_with_timeout "$hostname_timeout" dscacheutil -q host -a ip_address "$ip" 2>/dev/null | awk '$1 == "name:" { print $2; exit }')"
        fi
        if [[ -n "$host" ]]; then
            printf '%s\n' "$host"
            return
        fi

        if command -v timeout >/dev/null 2>&1 && command -v avahi-resolve-address >/dev/null 2>&1; then
            host="$(timeout "$hostname_timeout" avahi-resolve-address "$ip" 2>/dev/null | { read -r _ name _; printf '%s' "${name%.}"; })"
            if [[ -n "$host" ]]; then
                printf '%s\n' "$host"
                return
            fi
        fi
    done

    printf -- '-\n'
}

open_ports_for() {
    local ip="$1"
    local port
    local open_ports=""

    for port in "${port_list[@]}"; do
        port="${port//[[:space:]]/}"
        [[ -z "$port" ]] && continue
        if command -v nc >/dev/null 2>&1; then
            if [[ "$(uname -s)" == "Darwin" ]]; then
                nc -z -G "$timeout" -w "$timeout" "$ip" "$port" </dev/null >/dev/null 2>&1 || continue
            else
                nc -z -w "$timeout" "$ip" "$port" </dev/null >/dev/null 2>&1 || continue
            fi
        elif command -v timeout >/dev/null 2>&1; then
            timeout "$timeout" bash -c '</dev/tcp/$1/$2' _ "$ip" "$port" 2>/dev/null || continue
        else
            continue
        fi
        open_ports="${open_ports:+$open_ports,}$port"
    done

    printf '%s\n' "$open_ports"
}

candidate_ips() {
    for i in {1..254}; do
        printf '%s%s\n' "$prefix" "$i"
    done
}

scan_one() {
    local ip="$1"
    local open_ports
    local host

    is_excluded "$ip" && return

    open_ports="$(open_ports_for "$ip")"
    [[ -z "$open_ports" ]] && return

    host="$(hostname_for "$ip")"
    printf '%s\t%s\t%s\n' "$ip" "$host" "$open_ports"
}

tmpfile="$(mktemp)"
hostname_file="$(mktemp)"
trap 'rm -f "$tmpfile" "$hostname_file"' EXIT
log 'discovering Bonjour SSH hostnames'
discover_bonjour_hosts > "$hostname_file"
log 'detecting local IPs to exclude from results'
excluded_count=0
while IFS= read -r excluded; do
    [[ -z "$excluded" ]] && continue
    excluded_ips[excluded_count]="$excluded"
    ((excluded_count += 1))
done < <(
    for excluded in ${excludes[@]+"${excludes[@]}"}; do
        printf '%s\n' "$excluded"
    done
    local_ips
)
log "excluding $excluded_count IP(s): ${excluded_ips[*]:-(none)}"
log "scanning ${prefix}1-${prefix}254 on port(s) $ports with timeout ${timeout}s and $workers workers"
active_jobs=0

while read -r ip; do
    [[ -z "$ip" ]] && continue
    scan_one "$ip" >> "$tmpfile" &
    ((active_jobs += 1))
    if (( active_jobs >= workers )); then
        wait
        active_jobs=0
    fi
done < <(candidate_ips)

wait
log 'scan complete; formatting matching hosts'

printf '\n%s%sSSH Hosts%s\n\n' "$bold" "$accent_color" "$reset"
printf '%s%s%-15s %-35s %-10s%s\n' "$bold" "$accent_color" IP HOSTNAME PORTS "$reset"
printf '%-15s %-35s %-10s\n' '---------------' '-----------------------------------' '----------'
LC_ALL=C sort -u -t . -k 1,1n -k 2,2n -k 3,3n -k 4,4n "$tmpfile" | while IFS=$'\t' read -r ip host open_ports; do
    printf '%-15s %-35s %-10s\n' "$ip" "$host" "$open_ports"
done
