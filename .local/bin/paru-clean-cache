#!/usr/bin/bash
set -euo pipefail

usage() {
  printf 'Usage: paru-clean-cache [--dry-run|--prune]\n' >&2
}

if (( $# > 1 )); then
  usage
  exit 2
fi

case "${1:---prune}" in
  --dry-run) mode=dry-run ;;
  --prune) mode=prune ;;
  --help|-h) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac

clone_dir="${XDG_CACHE_HOME:-$HOME/.cache}/paru/clone"
shopt -s nullglob
for dir in "$clone_dir"/* "$clone_dir"/*/*; do
  [[ -f "$dir/PKGBUILD" ]] || continue

  # The verbose dry run lists candidate archives, or only a message if empty.
  preview=$(paccache -d -v -k 2 -c "$dir")
  [[ "$preview" == *'.pkg.tar'* ]] || continue

  printf '\n==> %s\n' "${dir##*/}"
  if [[ "$mode" == dry-run ]]; then
    printf '%s\n' "$preview"
  else
    paccache -r -k 2 -c "$dir"
  fi
done
